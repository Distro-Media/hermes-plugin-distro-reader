{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "distro-reader",
  "version": "1.1.0",
  "description": "Read independent news and content from Distro publications with search, feeds, archive research, stories, books, podcasts, visual rendering, payment information, and user-approved tips.",
  "author": {
    "name": "Distro Media",
    "url": "https://distro.media"
  },
  "homepage": "https://distro.media",
  "repository": "https://github.com/Distro-Media/hermes-plugin-distro-reader",
  "license": "MIT",
  "keywords": [
    "distro",
    "reader",
    "news",
    "publishing",
    "mcp",
    "books",
    "podcasts",
    "x402"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "distro-reader": {
          "trust": "untrusted",
          "timeout": 120
        }
      }
    }
  }
}
